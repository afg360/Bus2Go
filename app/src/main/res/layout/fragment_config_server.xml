<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.config.ConfigActivity"
    >
    
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/config_select_server_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="50dp"
        android:text="Select a server"
        android:textSize="35sp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        />
    
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/config_select_server_description"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="Please select a Bus2Go server to connect to"
        android:textSize="30sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/config_select_server_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="40dp"
        app:layout_constraintTop_toBottomOf="@id/config_select_server_description"
        >
        
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/config_select_server_textInputLayout"
            android:layout_width="250dp"
            android:layout_height="70dp"
            android:hint="api.bus2go.app"
            app:helperTextEnabled="true"
            app:helperText="An ip address..."
            android:layout_marginHorizontal="25dp"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/config_select_server_textInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="text|textNoSuggestions|textUri"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            >
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/config_select_server_type_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="bottom"
                android:layout_marginHorizontal="10dp"
                />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/config_select_server_type_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"
                />
        </LinearLayout>
    </LinearLayout>
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/config_select_server_continue_button"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginBottom="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/config_server_continue_button_progress_indicator"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/config_select_server_continue_button"
        app:layout_constraintBottom_toBottomOf="@id/config_select_server_continue_button"
        app:layout_constraintStart_toStartOf="@id/config_select_server_continue_button"
        app:layout_constraintEnd_toEndOf="@id/config_select_server_continue_button"
        />
    

</androidx.constraintlayout.widget.ConstraintLayout>
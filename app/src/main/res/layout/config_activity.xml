<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/configActivityMainconstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/configActivityFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/config_continue_button"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:text="@string/config_continue"
        android:textSize="25sp"
        android:textColor="@color/black"
        android:paddingVertical="9dp"
        android:layout_marginBottom="200dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/config_button_progress_indicator"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/config_continue_button"
        app:layout_constraintBottom_toBottomOf="@id/config_continue_button"
        app:layout_constraintStart_toStartOf="@id/config_continue_button"
        app:layout_constraintEnd_toEndOf="@id/config_continue_button"
        />
    
</androidx.constraintlayout.widget.ConstraintLayout>
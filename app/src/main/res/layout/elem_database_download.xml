<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp"
    >
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/settings_database_download_state_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/check"
        android:translationY="2.0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/settings_database_download_name"
        android:layout_width="75dp"
        android:layout_height="35dp"
        android:text="Agency"
        android:textSize="18sp"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/settings_database_download_file_size"
        app:layout_constraintStart_toEndOf="@id/settings_database_download_state_image_view"
        />
    
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/settings_database_download_file_size"
        android:layout_width="75dp"
        android:layout_height="25dp"
        android:text="File Size: "
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/settings_database_download_state_image_view"
        app:layout_constraintTop_toBottomOf="@id/settings_database_download_name"
        app:layout_constraintBottom_toBottomOf="@id/settings_database_download_progress_bar"
        />
    
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/settings_database_download_expiration_date"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:text="Expires in ..."
        android:textSize="16sp"
        android:alpha="0.7"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toTopOf="@id/settings_database_download_name"
        app:layout_constraintBottom_toBottomOf="@id/settings_database_download_progress_bar"
        app:layout_constraintStart_toEndOf="@id/settings_database_download_name"
        />
    
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/settings_database_download_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:paddingVertical="2dp"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:trackStopIndicatorSize="0dp"
        app:indicatorTrackGapSize="0dp"
        tools:visibility="visible"
        />

</androidx.constraintlayout.widget.ConstraintLayout>

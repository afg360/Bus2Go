<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    >
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            app:layout_constraintBottom_toTopOf="@id/settings_database_download_progress_bar"
            app:layout_constraintTop_toTopOf="parent"
            >
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settings_database_download_state_image_view"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/check"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_database_download_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:text="Agency"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/settings_database_download_expiration_date"
                app:layout_constraintStart_toEndOf="@id/settings_database_download_state_image_view"
                app:layout_constraintTop_toTopOf="parent"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_database_download_file_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:text="File Size: "
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/settings_database_download_state_image_view"
                app:layout_constraintTop_toBottomOf="@id/settings_database_download_name"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_database_download_expiration_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires in ..."
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="13sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        
        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/settings_database_download_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorTrackGapSize="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:trackStopIndicatorSize="0dp"
            tools:visibility="visible"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
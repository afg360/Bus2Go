<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    
    <!-- App Updates -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_notifications"
            android:textColor="@color/basic_blue"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="70dp"
            />
        
        <!-- Update Notifications -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_app_updates_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="15dp"
            >
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settings_app_updates_icon_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/notifications"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_app_updates_title_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/update_notifications"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/settings_app_updates_descr_text_view"
                app:layout_constraintStart_toEndOf="@id/settings_app_updates_icon_view"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_app_updates_descr_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/update_notifications_summary"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toBottomOf="@id/settings_app_updates_title_text_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/settings_app_updates_icon_view"
                />
            
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_app_updates_toggle_switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        
        </androidx.constraintlayout.widget.ConstraintLayout>
        
        
        <!-- Auto Updates, Depends on App updates -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_app_auto_updates_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="15dp"
            >
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settings_app_auto_updates_icon_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/baseline_update"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_app_auto_updates_title_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/auto_updates"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/settings_app_auto_updates_descr_text_view"
                app:layout_constraintStart_toEndOf="@id/settings_app_auto_updates_icon_view"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_app_auto_updates_descr_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/auto_updates_summary"
                android:layout_marginStart="30dp"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/settings_app_auto_updates_title_text_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/settings_app_auto_updates_icon_view"
                />
            
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_app_auto_updates_toggle_switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        
        </androidx.constraintlayout.widget.ConstraintLayout>
        
    </androidx.appcompat.widget.LinearLayoutCompat>
    
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        />
    
    <!-- Database Updates -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Database Updates"
            android:textColor="@color/basic_blue"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="70dp"
            />
        
        <!-- Manual Download -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_database_manual_download_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:text="Manual Download"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingHorizontal="70dp"
            android:paddingVertical="15dp"
            />
        
        <!-- Database Updates Notifications -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_database_updates_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="15dp"
            >
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settings_database_updates_icon_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/notifications"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_database_updates_title_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/db_update_notifs"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/settings_database_updates_descr_text_view"
                app:layout_constraintStart_toEndOf="@id/settings_database_updates_icon_view"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_database_updates_descr_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/db_update_notifs_summary"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toBottomOf="@id/settings_database_updates_title_text_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/settings_database_updates_icon_view"
                />
            
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_database_updates_toggle_switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            
        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <!-- Automatic Database Updates, depends on Database Updates Notifs  -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_auto_database_updates_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="15dp"
            >
            
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/settings_auto_database_updates_icon_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/baseline_update"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_auto_database_updates_title_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/db_auto_updates"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/settings_auto_database_updates_descr_text_view"
                app:layout_constraintStart_toEndOf="@id/settings_auto_database_updates_icon_view"
                />
            
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_auto_database_updates_descr_text_view"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:text="@string/db_auto_updates_summary"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="30dp"
                app:layout_constraintTop_toBottomOf="@id/settings_auto_database_updates_title_text_view"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/settings_auto_database_updates_icon_view"
                />
            
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_auto_database_updates_toggle_switch_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        
        </androidx.constraintlayout.widget.ConstraintLayout>
        
    </androidx.appcompat.widget.LinearLayoutCompat>
    
</androidx.appcompat.widget.LinearLayoutCompat>